def btn(text: str, data: str) -> InlineKeyboardButton:
    return InlineKeyboardButton(text, callback_data=data)


CANCEL_ROW = [btn("❌ Huỷ", "cancel")]


async def show(update: Update, text: str, kb: InlineKeyboardMarkup | None = None) -> None:
    """Sửa tin nhắn nếu vừa bấm nút, ngược lại gửi tin mới."""
    if update.callback_query:
        await update.callback_query.edit_message_text(text, reply_markup=kb)
    else:
        await update.effective_message.reply_text(text, reply_markup=kb)


def get_draft(ctx: ContextTypes.DEFAULT_TYPE) -> dict | None:
    return ctx.user_data.get("draft")


async def _expired(update: Update) -> int:
    await show(update, "Phiếu đã hết hạn, gõ /hoadon để tạo lại.")
    return ConversationHandler.END


async def _fail(update: Update, ctx: ContextTypes.DEFAULT_TYPE, e: BackendError) -> int:
    ctx.user_data.pop("draft", None)
    await show(update, f"⚠️ {e.message}\n\nGõ /hoadon để thử lại.")
    return ConversationHandler.END


def _head(d: dict) -> str:
    v = d["vehicle"]
    head = f"🚗 {v['plate']}" + (f" · {v['label']}" if v.get("label") else "")
    if v.get("size"):
        head += f" · size {v['size']}"
    if v.get("customerName"):
        head += f"\n👤 {v['customerName']}"
    return head


def _selected_text(d: dict) -> str:
    lines = d["lines"]
    return f"\n\n✅ Đã chọn {len(lines)} mục — {money(orders.subtotal(lines))}" if lines else ""


def groups_view(d: dict) -> tuple[str, InlineKeyboardMarkup]:
    chosen = {l["code"] for l in d["lines"]}
    rows = []
    for gi, g in enumerate(d["groups"]):
        n = sum(1 for s in g["services"] if s["code"] in chosen)
        rows.append([btn(f"📂 {g['name']}" + (f" ({n})" if n else ""), f"g:{gi}")])
    rows.append([btn("✔️ Xong", "done"), btn("✏️ Sửa giá", "adj")])
    rows.append(CANCEL_ROW)
    return f"{_head(d)}\n\nChọn nhóm dịch vụ:{_selected_text(d)}", InlineKeyboardMarkup(rows)


def group_view(d: dict, gi: int) -> tuple[str, InlineKeyboardMarkup]:
    g = d["groups"][gi]
    chosen = {l["code"] for l in d["lines"]}
    rows = [[btn(f"{'✅' if s['code'] in chosen else '⬜'} {s['name']} — {money(s['price'])}", f"s:{gi}:{si}")]
            for si, s in enumerate(g["services"])]
    rows.append([btn("⬅️ Nhóm khác", "groups"), btn("✔️ Xong", "done")])
    return f"{_head(d)}\n\n📂 {g['name']} (bấm để chọn / bỏ chọn):{_selected_text(d)}", InlineKeyboardMarkup(rows)


def employees_view(d: dict) -> tuple[str, InlineKeyboardMarkup]:
    btns = [btn(f"{'✅' if e['id'] in d['emp_sel'] else '⬜'} {e['name']}", f"e:{e['id']}") for e in d["emps"]]
    rows = [btns[i:i + 2] for i in range(0, len(btns), 2)]
    rows.append([btn("✔️ Xong / Bỏ qua", "edone")])
    rows.append(CANCEL_ROW)
    return "👷 Ai thực hiện? (chọn nhiều người được)", InlineKeyboardMarkup(rows)


def confirm_view(d: dict) -> tuple[str, InlineKeyboardMarkup]:
    sub = orders.subtotal(d["lines"])
    lines = ["🧾 XÁC NHẬN PHIẾU", _head(d), ""]
    for n, l in enumerate(d["lines"], 1):
        extra = f" (giá gốc {money(l['listed'])}: {l['reason']})" if l["adjusted"] is not None else ""
        lines.append(f"{n}. {l['name']} — {money(orders.line_price(l))}{extra}")
    lines.append("")
    if d["discount"]:
        lines += [f"Tạm tính: {money(sub)}", f"Giảm giá: -{money(d['discount'])}"]
    lines.append(f"💰 TỔNG: {money(sub - d['discount'])}")
    lines.append(f"Thanh toán: {orders.payment_option(d['payment_key'])['display']}")
    names = [e["name"] for e in d["emps"] if e["id"] in d["emp_sel"]]
    if names:
        lines.append(f"Thực hiện: {', '.join(names)}")
    if d["note"]:
        lines.append(f"Ghi chú: {d['note']}")
    kb = InlineKeyboardMarkup([[btn("✅ Xuất phiếu", "ok")],
                               [btn("✏️ Sửa dịch vụ", "edit"), btn("❌ Huỷ", "cancel")]])
    return "\n".join(lines), kb


