async def post_init(app: Application) -> None:
    await app.bot.set_my_commands([
        BotCommand("hoadon", "Tạo phiếu thanh toán mới"),
        BotCommand("lichsu", "Tra phiếu theo biển số"),
        BotCommand("in", "Xuất lại ảnh phiếu theo mã"),
        BotCommand("homnay", "Doanh thu hôm nay (quản lý)"),
        BotCommand("huy", "Huỷ phiếu đang tạo"),
    ])


async def post_shutdown(app: Application) -> None:
    await app.bot_data["api"].aclose()


def build_app(api: AlphaWashClient | None = None) -> Application:
    app = Application.builder().token(config.BOT_TOKEN).post_init(post_init).post_shutdown(post_shutdown).build()
    app.bot_data["api"] = api or AlphaWashClient()

    conv = ConversationHandler(
        entry_points=[CommandHandler("hoadon", start_invoice)],
        states={
            PLATE: [MessageHandler(TEXT, got_plate), CallbackQueryHandler(pick_recent, pattern=r"^rv:\d+$")],
            MODEL: [MessageHandler(TEXT, got_model), CallbackQueryHandler(pick_model, pattern=r"^mdl:\d+$")],
            SIZE: [CallbackQueryHandler(pick_size, pattern=r"^sz:(S|M|L|XL)$")],
            SERVICES: [
                CallbackQueryHandler(open_group, pattern=r"^g:\d+$"),
                CallbackQueryHandler(back_to_groups, pattern=r"^groups$"),
                CallbackQueryHandler(toggle_service, pattern=r"^s:\d+:\d+$"),
                CallbackQueryHandler(adj_pick_view, pattern=r"^adj$"),
                CallbackQueryHandler(services_done, pattern=r"^done$"),
            ],
            ADJ_PICK: [CallbackQueryHandler(adj_prompt, pattern=r"^ap:\d+$"),
                       CallbackQueryHandler(back_to_groups, pattern=r"^groups$")],
            ADJ_INPUT: [MessageHandler(TEXT, got_adj),
                        CallbackQueryHandler(adj_reset, pattern=r"^ar:\d+$"),
                        CallbackQueryHandler(back_to_groups, pattern=r"^groups$")],
            EMPLOYEES: [CallbackQueryHandler(toggle_employee, pattern=r"^e:\d+$"),
                        CallbackQueryHandler(employees_done, pattern=r"^edone$")],
            DISCOUNT: [CallbackQueryHandler(pick_discount, pattern=r"^disc:")],
            DISCOUNT_INPUT: [MessageHandler(TEXT, got_discount)],
            PAYMENT: [CallbackQueryHandler(pick_payment, pattern=r"^pay:")],
            NOTE: [MessageHandler(TEXT, got_note), CallbackQueryHandler(skip_note, pattern=r"^skipnote$")],
            CONFIRM: [CallbackQueryHandler(confirm, pattern=r"^ok$"),
                      CallbackQueryHandler(edit_services, pattern=r"^edit$")],
        },
        fallbacks=[CommandHandler("huy", cancel), CallbackQueryHandler(cancel, pattern=r"^cancel$")],
        allow_reentry=True,
        conversation_timeout=1800,     # 30 phút không thao tác -> tự đóng
    )
    app.add_handler(conv)
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("myid", cmd_myid))
    app.add_handler(CommandHandler("lichsu", cmd_history))
    app.add_handler(CommandHandler("in", cmd_reprint))
    app.add_handler(CommandHandler("homnay", cmd_today))
    app.add_handler(CommandHandler("huy", cancel))
    app.add_handler(CallbackQueryHandler(quick_confirm, pattern=r"^qok:(cash|bank|card|unpaid)$"))
    app.add_handler(CallbackQueryHandler(quick_cancel, pattern=r"^qcancel$"))
    app.add_handler(MessageHandler(TEXT & filters.ChatType.PRIVATE, quick_invoice))
    app.add_handler(CallbackQueryHandler(stale_button))
    app.add_error_handler(on_error)
    return app


def main() -> None:
    missing = [n for n, v in (("BOT_TOKEN", config.BOT_TOKEN), ("API_BASE_URL", config.API_BASE_URL),
                              ("API_USERNAME", config.API_USERNAME), ("API_PASSWORD", config.API_PASSWORD)) if not v]
    if missing:
        raise SystemExit(f"Thiếu {', '.join(missing)} trong .env (xem .env.example).")
    if config.API_BASE_URL.startswith("http://") and "localhost" not in config.API_BASE_URL \
            and "127.0.0.1" not in config.API_BASE_URL:
        log.warning("API_BASE_URL đang dùng http:// — mật khẩu và token đi qua mạng không mã hoá, hãy dùng https://")
    if not config.STAFF_USER_IDS:
        log.warning("Chưa có STAFF_USER_IDS/ADMIN_USER_IDS trong .env — nhắn /myid cho bot để lấy ID.")
    build_app().run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
