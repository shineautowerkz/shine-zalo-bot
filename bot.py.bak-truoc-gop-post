def _new_draft() -> dict:
    return {"vehicle": None, "groups": [], "lines": [], "emps": [], "emp_sel": [], "discount": 0,
            "payment_key": "", "note": "", "models": [], "recent": [], "adj_index": None}


@staff_only
async def start_invoice(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    d = ctx.user_data["draft"] = _new_draft()
    try:
        d["recent"] = (await api_of(ctx).recent_vehicles(6))[:6]
    except BackendError as e:
        log.warning("Không lấy được xe gần đây: %s", e.message)
    rows = []
    for i, r in enumerate(d["recent"]):
        name = " ".join(x for x in (r.get("brandName"), r.get("modelName")) if x)
        rows.append([btn(f"{r.get('licensePlate')} · {name}"[:60], f"rv:{i}")])
    if rows:
        rows.append(CANCEL_ROW)
    await update.effective_message.reply_text(
        "🧾 Tạo phiếu mới\n\nNhập biển số xe (VD: 51K-12345)" + ("\nhoặc chọn xe gần đây:" if rows else "")
        + "\n(Gõ /huy để thoát)",
        reply_markup=InlineKeyboardMarkup(rows) if rows else None)
    return PLATE


def _vehicle_from_check(res: dict, plate: str) -> dict:
    v = res.get("vehicle") or {}
    model = v.get("model") or {}
    brand = v.get("brand") or model.get("brand") or {}
    cust = v.get("customer") or res.get("customer") or {}
    return {"plate": v.get("licensePlate") or plate,
            "label": " ".join(x for x in (brand.get("brandName"), model.get("modelName")) if x),
            "size": str(model.get("size") or "").upper(),
            "brandCode": brand.get("code"), "modelCode": model.get("code"),
            "customerId": cust.get("id"), "customerName": cust.get("customerName")}


async def got_plate(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    plate = canonical_plate(update.message.text)
    if not plate:
        await update.message.reply_text("Biển số chưa đúng dạng, nhập lại nhé (VD: 51K-12345).")
        return PLATE
    try:
        res = await api_of(ctx).check_plate(plate)
    except BackendError as e:
        await update.message.reply_text(f"⚠️ {e.message}\nNhập lại biển số để thử lại, hoặc /huy.")
        return PLATE
    if res.get("exists") and res.get("vehicle"):
        d["vehicle"] = _vehicle_from_check(res, plate)
        return await _size_or_services(update, ctx, d)
    d["vehicle"] = {"plate": plate, "label": "", "size": "", "brandCode": None, "modelCode": None,
                    "customerId": None, "customerName": None}
    await update.message.reply_text(
        f"🚗 {plate} — xe mới, chưa có trong hệ thống.\n\nNhập tên dòng xe (VD: Vios, CX-5, X5):",
        reply_markup=InlineKeyboardMarkup([CANCEL_ROW]))
    return MODEL


async def pick_recent(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    r = d["recent"][int(q.data.split(":", 1)[1])]
    d["vehicle"] = {"plate": r.get("licensePlate") or "",
                    "label": " ".join(x for x in (r.get("brandName"), r.get("modelName")) if x),
                    "size": str(r.get("vehicleSize") or "").upper(),
                    "brandCode": r.get("brandCode"), "modelCode": r.get("modelCode"),
                    "customerId": r.get("customerId"), "customerName": r.get("customerName")}
    return await _size_or_services(update, ctx, d)


async def got_model(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    try:
        brands = await api_of(ctx).brands_with_models()
    except BackendError as e:
        return await _fail(update, ctx, e)
    tokens = fold(update.message.text).split()
    found = []
    for b in brands:
        for m in b.get("models") or []:
            hay = fold(f"{b.get('brandName', '')} {m.get('modelName', '')}")
            if tokens and all(t in hay for t in tokens):
                found.append({"brandCode": b.get("code"), "brandName": b.get("brandName"),
                              "modelCode": m.get("code"), "modelName": m.get("modelName"),
                              "size": str(m.get("size") or "").upper()})
    d["models"] = found[:8]
    if not d["models"]:
        await update.message.reply_text(
            "Không thấy dòng xe này. Thử tên ngắn hơn (VD: 'vios'), hoặc thêm xe vào AlphaWash trước.",
            reply_markup=InlineKeyboardMarkup([CANCEL_ROW]))
        return MODEL
    rows = [[btn(f"{m['brandName']} {m['modelName']}" + (f" ({m['size']})" if m["size"] else ""), f"mdl:{i}")]
            for i, m in enumerate(d["models"])]
    rows.append(CANCEL_ROW)
    await update.message.reply_text("Chọn đúng dòng xe:", reply_markup=InlineKeyboardMarkup(rows))
    return MODEL


async def pick_model(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    m = d["models"][int(q.data.split(":", 1)[1])]
    d["vehicle"].update(label=f"{m['brandName']} {m['modelName']}", size=m["size"],
                        brandCode=m["brandCode"], modelCode=m["modelCode"])
    return await _size_or_services(update, ctx, d)


async def _size_or_services(update: Update, ctx: ContextTypes.DEFAULT_TYPE, d: dict) -> int:
    if d["vehicle"]["size"] in SIZES:
        return await _to_services(update, ctx, d)
    kb = InlineKeyboardMarkup([[btn(s, f"sz:{s}") for s in SIZES], CANCEL_ROW])
    await show(update, f"{_head(d)}\n\nXe này chưa có size trong hệ thống. Chọn size:", kb)
    return SIZE


async def pick_size(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    d["vehicle"]["size"] = q.data.split(":", 1)[1]
    return await _to_services(update, ctx, d)


async def _to_services(update: Update, ctx: ContextTypes.DEFAULT_TYPE, d: dict) -> int:
    try:
        raw = await api_of(ctx).quick_services()
    except BackendError as e:
        return await _fail(update, ctx, e)
    d["groups"] = orders.groups_for_size(raw, d["vehicle"]["size"])
    if not d["groups"]:
        ctx.user_data.pop("draft", None)
        await show(update, f"Chưa có dịch vụ nào có giá cho size {d['vehicle']['size']} trong AlphaWash.")
        return ConversationHandler.END
    text, kb = groups_view(d)
    await show(update, text, kb)
    return SERVICES


async def open_group(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    text, kb = group_view(d, int(q.data.split(":", 1)[1]))
    await q.edit_message_text(text, reply_markup=kb)
    return SERVICES


async def back_to_groups(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    text, kb = groups_view(d)
    await q.edit_message_text(text, reply_markup=kb)
    return SERVICES


async def toggle_service(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    _, gi, si = q.data.split(":")
    s = d["groups"][int(gi)]["services"][int(si)]
    existing = next((l for l in d["lines"] if l["code"] == s["code"]), None)
    if existing:
        d["lines"].remove(existing)
    else:
        d["lines"].append({"code": s["code"], "name": s["name"], "listed": s["price"],
                           "adjusted": None, "reason": None})
    text, kb = group_view(d, int(gi))
    await q.edit_message_text(text, reply_markup=kb)
    return SERVICES


