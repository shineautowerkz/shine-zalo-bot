async def deliver_invoice(ctx: ContextTypes.DEFAULT_TYPE, chat_id: int, order: dict) -> None:
    """Gửi PDF hoá đơn: ưu tiên PDF của AlphaWash (có QR) nếu đã bật, ngược lại PDF tự vẽ."""
    api = api_of(ctx)
    inv = orders.order_to_invoice(order)
    safe = re.sub(r"[^0-9A-Za-z._-]", "_", str(inv["number"]) or "hoadon")
    if api.pdf_enabled():
        try:
            pdf = await api.download_invoice_pdf(str(order.get("id") or ""), str(order.get("code") or ""))
            await ctx.bot.send_document(chat_id=chat_id, document=io.BytesIO(pdf), filename=f"{safe}.pdf",
                                        caption=f"🧾 {inv['number']} · {inv['plate']}")
            return
        except BackendError as e:
            log.error("Không lấy được PDF cho %s: %s", inv["number"], e.message)
            notice = f"⚠️ Không lấy được PDF từ AlphaWash ({e.message}). PDF tự vẽ, KHÔNG có mã QR.\n"
    else:
        notice = ""
    path = await asyncio.to_thread(render_invoice, inv)
    with path.open("rb") as f:
        await ctx.bot.send_document(chat_id=chat_id, document=f, filename=f"{safe}.pdf",
                                    caption=f"{notice}🧾 {inv['number']} · {inv['plate']} · {money(inv['total'])}")

async def confirm(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    d = get_draft(ctx)
    if d is None:
        await q.answer("Phiếu này đã xuất hoặc đã huỷ.", show_alert=True)
        return ConversationHandler.END
    await q.answer("Đang tạo phiếu...")
    user = update.effective_user
    payload = orders.build_order_payload(d, user.full_name)
    ctx.user_data.pop("draft", None)          # chặn bấm 2 lần -> trùng phiếu

    api = api_of(ctx)
    try:
        order_id = await api.create_order(payload)
    except BackendError as e:
        if e.definitive:                      # BE chắc chắn chưa tạo -> cho sửa/thử lại
            ctx.user_data["draft"] = d
            text, kb = confirm_view(d)
            await q.edit_message_text(f"⚠️ AlphaWash từ chối: {e.message}\n\n{text}", reply_markup=kb)
            return CONFIRM
        log.error("create-order không rõ kết quả: %s (NV %s)", e.message, user.id)
        await q.edit_message_text(
            f"⚠️ {e.message}\nChưa rõ phiếu đã được tạo hay chưa. KHÔNG tạo lại ngay — "
            f"hãy kiểm tra trong AlphaWash (biển số {d['vehicle']['plate']}) rồi mới tạo lại nếu chưa có.")
        return ConversationHandler.END

    try:
        order = await api.get_order(order_id)
    except BackendError as e:
        log.error("Đã tạo đơn %s nhưng không đọc lại được: %s", order_id, e.message)
        await q.edit_message_text(
            f"✅ Đã tạo phiếu trong AlphaWash nhưng chưa vẽ được ảnh ({e.message}).\n"
            "Dùng /in <mã phiếu> để xuất ảnh sau.")
        return ConversationHandler.END

    number = order.get("code") or order_id
    await q.edit_message_text(f"✅ Đã tạo phiếu {number}")
    await deliver_invoice(ctx, q.message.chat_id, order)
    log.info("Order %s created by %s (%s)", number, user.full_name, user.id)
    return ConversationHandler.END


