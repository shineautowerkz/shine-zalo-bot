async def adj_reset(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    l = d["lines"][int(q.data.split(":", 1)[1])]
    l["adjusted"], l["reason"] = None, None
    text, kb = groups_view(d)
    await q.edit_message_text(text, reply_markup=kb)
    return SERVICES


async def got_adj(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    d = get_draft(ctx)
    if d is None or d["adj_index"] is None:
        return await _expired(update)
    price_txt, _, reason = update.message.text.partition("|")
    price = parse_money(price_txt, allow_zero=True)
    if price is None:
        await update.message.reply_text("Chưa hiểu giá. Gõ lại dạng:  giá mới | lý do   (VD: 150k | Khách VIP)")
        return ADJ_INPUT
    l = d["lines"][d["adj_index"]]
    l["adjusted"], l["reason"] = price, (reason.strip()[:100] or "Điều chỉnh giá")
    text, kb = groups_view(d)
    await update.message.reply_text(text, reply_markup=kb)
    return SERVICES


# ---- thợ thực hiện ---------------------------------------------------------------
async def services_done(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    d = get_draft(ctx)
    if d is None:
        await q.answer()
        return await _expired(update)
    if not d["lines"]:
        await q.answer("Chưa chọn dịch vụ nào", show_alert=True)
        return SERVICES
    await q.answer()
    try:
        emps = await api_of(ctx).employees()
    except BackendError as e:
        log.warning("Không lấy được danh sách thợ: %s", e.message)
        emps = []
    d["emps"] = [{"id": e["id"], "name": e["name"]} for e in emps
                 if (e.get("workStatus") or "Working") == "Working" and e.get("name")]
    d["emp_sel"] = []
    if not d["emps"]:
        return await _ask_discount(update, d)
    text, kb = employees_view(d)
    await q.edit_message_text(text, reply_markup=kb)
    return EMPLOYEES


async def toggle_employee(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    eid = int(q.data.split(":", 1)[1])
    if eid in d["emp_sel"]:
        d["emp_sel"].remove(eid)
    else:
        d["emp_sel"].append(eid)
    text, kb = employees_view(d)
    await q.edit_message_text(text, reply_markup=kb)
    return EMPLOYEES


async def employees_done(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    await update.callback_query.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    return await _ask_discount(update, d)


# ---- giảm giá / thanh toán / ghi chú -----------------------------------------------
async def _ask_discount(update: Update, d: dict) -> int:
    kb = InlineKeyboardMarkup([
        [btn("Không giảm", "disc:0"), btn("5%", "disc:p5"), btn("10%", "disc:p10")],
        [btn("✍️ Nhập số khác", "disc:other")], CANCEL_ROW])
    await show(update, f"🧾 Tạm tính: {money(orders.subtotal(d['lines']))}\n\nGiảm giá?", kb)
    return DISCOUNT


async def pick_discount(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    choice = q.data.split(":", 1)[1]
    if choice == "other":
        await q.edit_message_text("✍️ Nhập số giảm giá\nVD:  200k   1tr   10%",
                                  reply_markup=InlineKeyboardMarkup([CANCEL_ROW]))
        return DISCOUNT_INPUT
    d["discount"] = 0 if choice == "0" else int(orders.subtotal(d["lines"]) * int(choice[1:]) / 100)
    return await _ask_payment(update)


async def got_discount(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    amount = parse_discount(update.message.text, orders.subtotal(d["lines"]))
    if amount is None:
        await update.message.reply_text("Chưa hiểu số này. Nhập lại, VD: 200k, 1tr hoặc 10%")
        return DISCOUNT_INPUT
    d["discount"] = amount
    return await _ask_payment(update)


async def _ask_payment(update: Update) -> int:
    opts = [btn(o["label"], f"pay:{o['key']}") for o in orders.payment_options()]
    kb = InlineKeyboardMarkup([opts[i:i + 2] for i in range(0, len(opts), 2)] + [CANCEL_ROW])
    await show(update, "Hình thức thanh toán?", kb)
    return PAYMENT


async def pick_payment(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    q = update.callback_query
    await q.answer()
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    d["payment_key"] = q.data.split(":", 1)[1]
    kb = InlineKeyboardMarkup([[btn("⏭ Bỏ qua", "skipnote")], CANCEL_ROW])
    await q.edit_message_text("📝 Ghi chú (tình trạng xe, dặn dò...)\nGõ ghi chú hoặc bấm Bỏ qua.", reply_markup=kb)
    return NOTE


async def got_note(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    d = get_draft(ctx)
    if d is None:
        return await _expired(update)
    note = update.message.text.strip()
    if len(note) > 300:
        await update.message.reply_text("Ghi chú dài quá (tối đa 300 ký tự), gõ ngắn lại nhé.")
        return NOTE
    d["note"] = note
