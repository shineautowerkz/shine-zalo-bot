def _deny_text(user_id: int | None) -> str:
    return ("⛔ Bạn chưa được cấp quyền dùng bot này.\n"
            f"ID Telegram của bạn: {user_id}\n"
            "Gửi ID này cho quản lý để được thêm vào.")


def staff_only(func):
    @wraps(func)
    async def wrapper(update: Update, ctx: ContextTypes.DEFAULT_TYPE, *a, **kw):
        user = update.effective_user
        if user is None or user.id not in config.STAFF_USER_IDS:
            if update.effective_message:
                await update.effective_message.reply_text(_deny_text(user.id if user else None))
            return ConversationHandler.END
        return await func(update, ctx, *a, **kw)
    return wrapper


def admin_only(func):
    @wraps(func)
    async def wrapper(update: Update, ctx: ContextTypes.DEFAULT_TYPE, *a, **kw):
        user = update.effective_user
        if user is None or user.id not in config.ADMIN_USER_IDS:
            await update.effective_message.reply_text("⛔ Lệnh này chỉ dành cho quản lý.")
            return
        return await func(update, ctx, *a, **kw)
    return wrapper


