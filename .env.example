# Token lấy từ @BotFather (lệnh /newbot)
BOT_TOKEN=

# Telegram user ID, cách nhau bằng dấu phẩy. Lấy ID: nhắn /myid cho bot.
# ADMIN = chủ xưởng/quản lý (tạo phiếu + xem doanh thu /homnay)
ADMIN_USER_IDS=
# STAFF = nhân viên (tạo phiếu, tra cứu, in lại)
STAFF_USER_IDS=

# API AlphaWash. Staging hiện tại (dùng https, không dùng http):
API_BASE_URL=https://shine-autowerkz-service-staging.up.railway.app
# Tài khoản RIÊNG cho bot (quyền tối thiểu), không dùng tài khoản admin
API_USERNAME=
API_PASSWORD=
API_TIMEOUT=20

# --- Viết bài fanpage (/post) ---
# Key Gemini miễn phí: aistudio.google.com -> Get API key. Để trống = tắt /post
GEMINI_API_KEY=
# Để trống = tự chọn model Flash mới nhất
GEMINI_MODEL=
POST_LENGTH=vừa (120–180 chữ)

# --- Bot Zalo viết bài (tuỳ chọn) ---
ZALO_BOT_TOKEN=
# ID Zalo được dùng (gõ /id trong bot Zalo). Để trống = ai cũng dùng được
ZALO_ALLOWED_USER_IDS=

# ID Zalo được TẠO PHIẾU nhập nhanh. Để trống = tắt tạo phiếu trên Zalo
ZALO_STAFF_USER_IDS=
